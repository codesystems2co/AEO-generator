# Mac local gateway + shop backends (Optimizator manual E2E)
# 1. cp .env.gateway-testing.example .secrets/mac-gateway-testing.env
# 2. Fill values from your password manager / agent user store (mac-gateway-testing.json)
# 3. chmod 600 .secrets/mac-gateway-testing.env
# Never commit .secrets/ or paste real keys into docs, screenshots, or git.

GATEWAY_PORT=8081

ODOO_VHOST=http://odoo.aeo.local:8081
ODOO_BACKEND=127.0.0.1:18069
ODOO_XMLRPC_COMMON=http://127.0.0.1:18069/xmlrpc/2/common
ODOO_XMLRPC_OBJECT=http://127.0.0.1:18069/xmlrpc/2/object
ODOO_DB=osh
ODOO_LOGIN=admin
ODOO_PASSWORD=
ODOO_API_KEY=
ODOO_MASTER_PASSWORD=

PRESTA_VHOST=http://presta.aeo.local:8081
PRESTA_BACKEND=127.0.0.1:18080
PRESTA_ADMIN_LOGIN=admin@aeo.local
PRESTA_ADMIN_PASSWORD=
PRESTA_WEBSERVICE_KEY=

WOO_VHOST=http://woo.aeo.local:8081
WOO_BACKEND=127.0.0.1:18081
WOO_ADMIN_LOGIN=admin
WOO_ADMIN_PASSWORD=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
